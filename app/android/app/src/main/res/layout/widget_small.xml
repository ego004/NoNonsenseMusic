<?xml version="1.0" encoding="utf-8"?>
<!-- The widget at 2 x 2: the cover and like, the song, and previous / play / next. NowPlayingWidget.kt fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/cover"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_cover_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_cover"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_no_cover"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/like"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_like"
            android:src="@drawable/widget_heart_outline"/>
    </LinearLayout>
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/widget_nothing_played"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:letterSpacing="-0.01"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_muted"
        android:textSize="10sp"/>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_previous"
            android:src="@drawable/widget_prev"/>
        <ImageButton
            android:id="@+id/play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_play"
            android:src="@drawable/widget_play"/>
        <ImageButton
            android:id="@+id/next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/widget_next"/>
    </LinearLayout>
</LinearLayout>
