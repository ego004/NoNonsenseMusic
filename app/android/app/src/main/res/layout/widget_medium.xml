<?xml version="1.0" encoding="utf-8"?>
<!-- The widget at 4 x 2: the cover as tall as the room above the buttons, the song and like beside it; previous,
     back 10 s, play, forward 10 s and next under them. NowPlayingWidget.kt fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <!-- As wide as it is tall. -->
        <ImageView
            android:id="@+id/cover"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:background="@drawable/widget_cover_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_cover"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_no_cover"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_nothing_played"
                android:textColor="@color/widget_ink"
                android:textSize="18sp"
                android:letterSpacing="-0.01"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/widget_muted"
                android:textSize="14sp"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/like"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_like"
            android:src="@drawable/widget_heart_outline"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <include layout="@layout/widget_controls"/>
</LinearLayout>
