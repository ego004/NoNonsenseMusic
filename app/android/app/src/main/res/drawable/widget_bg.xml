<?xml version="1.0" encoding="utf-8"?>
<!-- GlassSurface (lib/ui/glass.dart): a diagonal gradient, top left to bottom right, with a hairline edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="315" android:startColor="@color/widget_glass_start" android:endColor="@color/widget_glass_end"/>
    <stroke android:width="1dp" android:color="@color/widget_edge"/>
    <corners android:radius="@dimen/widget_radius"/>
</shape>
